# ==============================================================================
# SeeGuide Environment Configuration (.env.example)
# Privacy-First Phone-Camera Assistant for Blind and Low-Vision Users
# OpenCV AI Competition 2026 (Agentic Vision Award)
# ==============================================================================

# Server Environment Mode: 'local', 'test', or 'production'
ENVIRONMENT=local

# Application Logging Level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# Storage Mode:
# Set to 'true' for local filesystem mock storage (data/traces/ and data/objects/)
# Set to 'false' to persist traces to AWS DynamoDB and assets to AWS S3
USE_MOCK_STORAGE=true

# AWS Cloud Infrastructure Settings (Only used when USE_MOCK_STORAGE=false)
# Recommended Free-Tier region: us-east-1
AWS_REGION=us-east-1

# DynamoDB Table Name for 7-day TTL structured telemetry traces (NFR-6)
DYNAMODB_TRACE_TABLE=seeguide-traces

# S3 Bucket Name for anonymized clips, evaluation CSVs, and model assets
S3_BUCKET_NAME=seeguide-assets

# Optional AWS Credentials for local development against live AWS
# On EC2 instances, leave blank to use the attached IAM instance profile (least-privilege)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# OpenCV Zoo Model Paths (Relative to repository root or absolute paths)
# Provisioned automatically via: make models (or python scripts/download_models.py)
DETECTOR_MODEL_PATH=models/yolox_nano.onnx
OCR_DET_PATH=models/text_detection_DB.onnx
OCR_REC_PATH=models/text_recognition_CRNN.onnx
YUNET_MODEL_PATH=models/face_detection_yunet.onnx
VOCABULARY_PATH=models/charset_36_EN.txt
