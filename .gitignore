# ==============================================================================
# SeeGuide .gitignore
# Privacy-first, least-privilege, and clean repository tracking rules
# ==============================================================================

# Environment & Secrets (Never commit credentials or active env files)
.env
*.env
!.env.example
secrets/
credentials/
*.pem
*.key

# Python Bytecode & Package Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Test Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node / Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server & Runtime Logs
*.log
logs/

# Large Model Weights (Downloaded via `make models` / `scripts/download_models.py`)
models/
!models/.gitkeep

# Evaluation Media (Raw video recordings with potential PII are excluded)
eval/clips/raw/
eval/clips/*.mp4
!eval/clips/.gitkeep

# Local Mock Persistence Data (Traces & Uploaded Objects)
data/traces/*.json
!data/traces/.gitkeep
data/objects/*
!data/objects/.gitkeep

# Operating System & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
